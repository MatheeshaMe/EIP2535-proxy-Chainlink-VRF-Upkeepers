{
  "name": "coin-cave-smart-contracts",
  "version": "1.0.0",
  "description": "smart-contracts for the coin-cave",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheeshaMe/coin-cave-smart-contracts.git"
  },
  "scripts": {
    "compile": "hardhat compile",
    "clean": "npx hardhat clean",
    "test": "hardhat test",
    "test-staging": "hardhat test",
    "lint": "solhint 'contracts/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "format": "prettier --write .",
    "coverage": "hardhat coverage --solcoverjs ./.solcover.js",
    "deploy": "hardhat deploy",
    "fork": "hardhat node --network hardhat --no-deploy",
    "verify": "hardhat etherscan-verify"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.8",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@typechain/ethers-v5": "^11.0.0",
    "@typechain/hardhat": "^8.0.0",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "chai": "^4.3.7",
    "ethers": "^6.6.2",
    "hardhat": "^2.16.1",
    "hardhat-gas-reporter": "^1.0.9",
    "solidity-coverage": "^0.8.4",
    "ts-node": "^10.9.1",
    "typechain": "^8.2.0"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^4.9.3",
    "axios": "^1.6.3",
    "babel-eslint": "^10.1.0",
    "dotenv": "^10.0.0",
    "hardhat-deploy": "^0.11.44",
    "hardhat-deploy-ethers": "^0.4.1",
    "merkletreejs": "^0.3.11"
  },
  "mocha": {
    "timeout": 10000000
  },
  "author": "matheeshame",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MatheeshaMe/coin-cave-smart-contracts/issues"
  },
  "homepage": "https://github.com/MatheeshaMe/coin-cave-smart-contracts#readme"
}
